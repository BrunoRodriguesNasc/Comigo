# Banco (SQLite em dev). Em produção use Postgres e troque o provider em prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Senha do painel /admin (usuário: admin)
ADMIN_PASSWORD="troque-esta-senha"

# Opcional: habilita resumo e perguntas por IA. Sem chave, o app usa respostas determinísticas.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# Consultar Open Beauty Facts quando o código não estiver no catálogo local (true/false)
ENABLE_OPEN_BEAUTY_FACTS="true"
